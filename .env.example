# ============================================================
# Telegram Bot Invoice — Environment Variables
# ============================================================
# Copy to .env and fill with real values.
# Или запустите python setup.py для интерактивной настройки.
#
# Quick setup:
#   1. BOT_TOKEN — получить у @BotFather
#   2. BITRIX24_WEBHOOK_URL — webhook URL из корпоративного портала
#   3. BITRIX24_TELEGRAM_FIELD_ID — ID UF-поля с Telegram ID сотрудника
#   4. GOOGLE_SHEET_ID + GOOGLE_DRIVE_FOLDER_ID — из URL таблицы/папки
#   5. credentials.json — OAuth client (Google Cloud Console)
# ============================================================

# --- Telegram Bot ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
ALLOWED_CHAT_ID=-1001234567890
# Резервные ID (если Bitrix24 недоступен)
ALLOWED_USER_IDS=[123456789, 987654321]

# --- Bitrix24 (корпоративный справочник сотрудников) ---
# Webhook URL для REST API (секретная переменная!)
BITRIX24_WEBHOOK_URL=https://b24-s0m8nc.bitrix24.ru/rest/1/89twzdg7vj88eytd
# ID кастомного UF-поля, где хранится Telegram ID сотрудника
# Пример: UF_USR_1785740541166 → значение "7106724608"
BITRIX24_TELEGRAM_FIELD_ID=UF_USR_1785740541166

# --- Google (OAuth 2.0 от личного аккаунта) ---
GOOGLE_SHEET_ID=1ABCdefGHIjklMNOpqrsTUVwxyz123456789
GOOGLE_DRIVE_FOLDER_ID=1XYZabcDEFghiJKLmnoPQRstuvWXYz98765

# --- Security ---
MAX_INVOICE_FILE_SIZE_MB=10
