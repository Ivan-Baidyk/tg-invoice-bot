# ============================================================
# Telegram Bot Invoice — Environment Variables
# ============================================================
# Copy to .env and fill with actual values.
#
# Google OAuth setup (one-time):
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create OAuth client ID → Desktop application
#   3. Download JSON → save as credentials.json in project root
#   4. First run opens browser → click "Allow" → token.json saved
#   5. All subsequent runs use token.json (no browser)
# ============================================================

# --- Telegram Bot ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
ALLOWED_CHAT_ID=-1001234567890
ALLOWED_USER_IDS=[123456789, 987654321]
URGENT_NOTIFY_USER_ID=123456789

# --- Google ---
GOOGLE_SHEET_ID=1ABCdefGHIjklMNOpqrsTUVwxyz123456789
GOOGLE_DRIVE_FOLDER_ID=1XYZabcDEFghiJKLmnoPQRstuvWXYz98765

# --- Security ---
MAX_INVOICE_FILE_SIZE_MB=10
