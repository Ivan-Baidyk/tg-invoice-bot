# ============================================================
# Telegram Bot Invoice — Environment Variables
# ============================================================
# Copy to .env and fill with actual values.
#
# Quick setup:
#   1. Fill BOT_TOKEN + ALLOWED_CHAT_ID (Telegram)
#   2. Fill BITRIX24_* (employee directory)
#   3. Fill GOOGLE_* (Sheets + Drive)
#   4. Place credentials.json (Google OAuth) in project root
#   5. Run: uv run python bot.py
# ============================================================

# --- Telegram Bot ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# --- Bitrix24 (corporate employee directory) ---
# Webhook URL for REST API access (keep secret!)
BITRIX24_WEBHOOK_URL=https://b24-s0m8nc.bitrix24.ru/rest/1/89twzdg7vj88eytd
# Custom field ID that stores employee Telegram user_id
BITRIX24_TELEGRAM_FIELD_ID=UF_CRM_12345678

# --- Google ---
GOOGLE_SHEET_ID=1ABCdefGHIjklMNOpqrsTUVwxyz123456789
GOOGLE_DRIVE_FOLDER_ID=1XYZabcDEFghiJKLmnoPQRstuvWXYz98765

# --- Security ---
MAX_INVOICE_FILE_SIZE_MB=10
